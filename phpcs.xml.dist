<?xml version="1.0"?>
<ruleset name="translate-sidecar">
    <description>PSR-12 for the plugin and its tests.</description>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>translate-sidecar.php</file>
    <file>uninstall.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
    <!-- WordPress names its hooks, callbacks and stub functions in snake case. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>tests/Support/MysqliWpdb.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/stubs/*</exclude-pattern>
        <exclude-pattern>translate-sidecar.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
        <exclude-pattern>src/autoload.php</exclude-pattern>
        <exclude-pattern>src/functions.php</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>
</ruleset>
